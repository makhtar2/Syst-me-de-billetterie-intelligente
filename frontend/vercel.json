{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/abonnements/:path*",
      "destination": "http://167.86.91.52:5065/api/abonnements/:path*"
    },
    {
      "source": "/api/billetterie/:path*",
      "destination": "http://167.86.91.52:5070/api/billetterie/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://167.86.91.52:8000/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://167.86.91.52:8000/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

