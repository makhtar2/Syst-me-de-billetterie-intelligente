PORT=5070
NODE_ENV=development

# ─── Production (Neon) ───────────────────────────────────────────────────────
# Sur Render, définir uniquement DATABASE_URL (fournie par Neon).
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Développement local (PostgreSQL) ────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=billetterie_db
DB_USER=postgres
DB_PASSWORD=postgres

# Base utilisee pour les tests
DB_NAME_TEST=billetterie_db_test

# Secret JWT identique pour interoperabilite
JWT_SECRET=

# URLs des microservices partenaires (sur Render, mettre les vraies URLs Render)
SERVICE_UTILISATEURS_URL=http://localhost:5050
SERVICE_ABONNEMENTS_URL=http://localhost:5065
