# Caddyfile — Reverse proxy HTTPS automatique pour le système de billetterie
# Caddy obtient un certificat Let's Encrypt automatiquement pour le domaine sslip.io.
# Ports requis ouverts sur le VPS : 80 (validation ACME) et 443 (HTTPS).

billetterie.167-86-91-52.sslip.io {

  # Compression gzip — réduit la taille des réponses JSON et HTML
  encode gzip

  # ── Service Abonnements (port 5065) ──────────────────────────────────────
  handle /api/abonnements/* {
    reverse_proxy abonnements:5065
  }

  # ── Service Billetterie & QR Code (port 5070) ────────────────────────────
  handle /api/billetterie/* {
    reverse_proxy billetterie:5070
  }

  # ── Service Utilisateurs & Auth (port 8000) ──────────────────────────────
  handle /api/* {
    reverse_proxy backend:8000
  }

  # ── Fichiers uploadés (photos de profil, etc.) ───────────────────────────
  handle /uploads/* {
    reverse_proxy backend:8000
  }

  # ── Frontend React (Nginx interne, port 80) ──────────────────────────────
  handle {
    reverse_proxy frontend:80
  }
}
