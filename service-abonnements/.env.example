PORT=5065
NODE_ENV=development

# ─── Production (Neon) ───────────────────────────────────────────────────────
# Sur Render, définir uniquement DATABASE_URL (fournie par Neon).
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Développement local (PostgreSQL) ────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=billetterie_abonnements
DB_USER=postgres
DB_PASSWORD=postgres

# Base utilisee par npm test, recreee a chaque execution
DB_NAME_TEST=billetterie_abonnements_test

# Doit etre IDENTIQUE au JWT_SECRET du Service Utilisateurs,
# sinon les jetons emis par lui seront rejetes ici.
JWT_SECRET=
